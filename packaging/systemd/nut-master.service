[Unit]
Description=nut master service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nut-server
Group=nut-server
WorkingDirectory=/usr/local/lib/nut-server
ExecStart=/usr/local/bin/nut-master -config /etc/nut-server/master.yaml
Restart=always
RestartSec=5

# Deliberately absent: NoNewPrivileges, RestrictSUIDSGID, LockPersonality,
# RestrictAddressFamilies, SystemCallArchitectures, SystemCallFilter,
# RestrictNamespaces, PrivateDevices, ProtectKernelTunables/Modules/Logs,
# ProtectClock, MemoryDenyWriteExecute, RestrictRealtime, DynamicUser.
# For a non-root unit each of them implies NoNewPrivileges=yes (systemd.exec(5)),
# which stops setuid sudo and makes `sudo -n /sbin/shutdown` fail.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nut-server
UMask=0027

[Install]
WantedBy=multi-user.target
